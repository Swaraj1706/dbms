CREATE TABLE Dept_J (
 dept_id INT PRIMARY KEY,
 dept_name VARCHAR(50)
);

CREATE TABLE Emp_J (
 emp_id INT PRIMARY KEY,
 name VARCHAR(50),
 dept_id INT,
 salary INT
);

