SELECT * FROM Dept_J;

SELECT * FROM Emp_J;

SELECT e.emp_id, e.name, d.dept_name
FROM Emp_J e
INNER JOIN Dept_J d
ON e.dept_id = d.dept_id;

SELECT e.emp_id, e.name, d.dept_name
FROM Emp_J e
LEFT JOIN Dept_J d
ON e.dept_id = d.dept_id;

SELECT d.dept_id, d.dept_name, e.name
FROM Dept_J d
RIGHT JOIN Emp_J e
ON d.dept_id = e.dept_id;

CREATE VIEW emp_view AS
SELECT name, salary FROM Emp_J;

SELECT * FROM emp_view;

CREATE VIEW dept_emp_view AS
SELECT e.name, d.dept_name
FROM Emp_J e
INNER JOIN Dept_J d
ON e.dept_id = d.dept_id;

SELECT * FROM dept_emp_view;

