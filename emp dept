SELECT *
FROM Employee
WHERE salary > 40000;

SELECT name
FROM Employee
WHERE name LIKE 'S%';

UPDATE Employee
SET salary = salary + (salary * 15/100)
WHERE dept_id = 1;

DELETE FROM Employee
WHERE joining_date < '2019-01-01';

SELECT dept_id,
AVG(salary) AS avg_salary
FROM Employee
GROUP BY dept_id;

SELECT dept_id,
COUNT(*) AS total
FROM Employee
GROUP BY dept_id;

SELECT dept_id,
COUNT(*) AS total
FROM Employee
GROUP BY dept_id
HAVING COUNT(*) > 2;

SELECT *
FROM Employee
WHERE salary > (
 SELECT AVG(salary)
 FROM Employee
);

SELECT *
FROM Employee
WHERE salary = (
 SELECT MAX(salary)
 FROM Employee
);
