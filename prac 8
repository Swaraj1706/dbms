CREATE TABLE employee2 (
 emp_id INT PRIMARY KEY,
 emp_name VARCHAR(50),
 salary INT
);

INSERT INTO employee2 VALUES (1, 'Ram', 50000);

INSERT INTO employee2 VALUES (2, 'Sham', 60000);

INSERT INTO employee2 VALUES (3, 'Tom', 55000);

SELECT * FROM employee2;

DROP TRIGGER IF EXISTS trg_check_salary;

DELIMITER //

CREATE TRIGGER trg_check_salary
BEFORE INSERT ON employee2
FOR EACH ROW
BEGIN
 IF NEW.salary <= 0 THEN
  SIGNAL SQLSTATE '45000'
  SET MESSAGE_TEXT = 'Salary must be greater than zero';
 END IF;
END //

DELIMITER ;

INSERT INTO employee2 VALUES (4, 'Aman', -1000);

DROP TRIGGER IF EXISTS trg_prevent_high_salary_delete;

DELIMITER //

CREATE TRIGGER trg_prevent_high_salary_delete
BEFORE DELETE ON employee2
FOR EACH ROW
BEGIN
 IF OLD.salary > 50000 THEN
  SIGNAL SQLSTATE '45000'
  SET MESSAGE_TEXT = 'Cannot delete employee with salary greater than 50000';
 END IF;
END //

DELIMITER ;

DELETE FROM employee2 WHERE emp_id = 2;

CREATE TABLE emp_audit (
 emp_id INT,
 action VARCHAR(20),
 action_date DATETIME
);

DROP TRIGGER IF EXISTS trg_emp_insert_audit;

DELIMITER //

CREATE TRIGGER trg_emp_insert_audit
AFTER INSERT ON employee2
FOR EACH ROW
BEGIN
 INSERT INTO emp_audit (emp_id, action, action_date)
 VALUES (NEW.emp_id, 'INSERT', NOW());
END //

DELIMITER ;

INSERT INTO employee2 VALUES (4, 'Aman', 40000);

SELECT * FROM emp_audit;

DROP TRIGGER IF EXISTS trg_default_salary;

DELIMITER //

CREATE TRIGGER trg_default_salary
BEFORE INSERT ON employee2
FOR EACH ROW
BEGIN
 IF NEW.salary IS NULL THEN
  SET NEW.salary = 30000;
 END IF;
END //

DELIMITER ;

INSERT INTO employee2 (emp_id, emp_name)
VALUES (5, 'Rohit');

SELECT * FROM employee2;
