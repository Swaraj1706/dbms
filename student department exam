CREATE TABLE Student (
 stud_id INT PRIMARY KEY,
 name VARCHAR(50),
 dept_id INT,
 marks INT
);

CREATE TABLE Exam (
 e_id INT PRIMARY KEY,
 stud_id INT,
 subject VARCHAR(50),
 marks INT,
 FOREIGN KEY (stud_id) REFERENCES Student(stud_id)
);

