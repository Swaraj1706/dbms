SELECT * FROM Employee;

UPDATE Employee
SET salary = salary + 5000
WHERE dept = 'IT';

SELECT * FROM Employee;

DELETE FROM Employee
WHERE emp_id = 4;

SELECT * FROM Employee;

SELECT name, salary,
salary * 2 AS double_salary
FROM Employee;

SELECT *
FROM Employee
WHERE salary > 35000
AND dept = 'IT';

SELECT *
FROM Employee
WHERE name LIKE 'A%';

SELECT UPPER(name), LENGTH(name)
FROM Employee;

SELECT name FROM Employee
UNION
SELECT proj_name FROM Project;
