SELECT branch_id,
SUM(acc_balance) AS total_balance
FROM Account
GROUP BY branch_id;

SELECT branch_id,
COUNT(acc_no) AS total_accounts
FROM Account
GROUP BY branch_id;

SELECT *
FROM Account
WHERE acc_balance = (
 SELECT MAX(acc_balance)
 FROM Account
);

SELECT *
FROM Account
WHERE acc_balance > (
 SELECT AVG(acc_balance)
 FROM Account
);
